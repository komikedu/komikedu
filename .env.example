NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=

# Provider gambar bawaan: "gemini" (bawaan, berbayar) atau "cloudflare" (FLUX.2 klein 4B, kuota gratis 10.000 neuron/hari).
# Token Cloudflare cukup izin "Workers AI: Read" dan "Workers AI: Edit".
IMAGE_PROVIDER=gemini
# Email yang boleh membuka /admin (dipisah koma). Provider yang dipilih di /admin menimpa IMAGE_PROVIDER.
ADMIN_EMAILS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
OPENAI_API_KEY=
MAYAR_API_KEY=
MAYAR_WEBHOOK_SECRET=

# Cloudflare R2 untuk gambar komik (opsional). Kalau kosong, gambar disimpan di bucket "panels" Supabase.
# R2_PUBLIC_URL = domain publik bucket (mis. https://img.komikedu.id atau https://pub-xxxx.r2.dev), tanpa garis miring di akhir.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
